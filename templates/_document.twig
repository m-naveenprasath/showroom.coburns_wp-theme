<!DOCTYPE html>
<html class="html {{ body_class }}" lang="{{ site.language }}">
	<head>
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<script>
			document.getElementsByTagName( "html" )[0].className += " js";
		</script>

		{{ function('wp_head') }}
	</head>
	<body>
		{% block body_open %}{% endblock %}

		<div class="site-wrapper">

		{% block layout %}

			{% block header %}
			{{ renderComponent("SiteHeader") }}
			{% endblock %}

			{% block shoulder %}{% endblock %}

			<main id="main">
				{% if function('post_password_required') %}
					{{ function('get_the_password_form') }}
				{% else %}
					{% block content %}
						No <code>{{ '{% block content %}' }}</code> defined for this template.
					{% endblock %}
				{% endif %}
			</main>

			{% block ankle %}
			{{ renderComponent("SiteAnkle") }}
			{% endblock %}

			{% block footer %}
			{{ renderComponent("SiteFooter") }}
			{% endblock %}

		{% endblock %}

		{% block offcanvas %}{% endblock %}

		</div>

		{% block body_close %}{% endblock %}

		{{ function('wp_footer') }}
	</body>
</html>


