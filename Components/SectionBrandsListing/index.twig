{% set local_namespace = "section-brands-listing" %}
{% set per_page = 12 %}

{% extends "partials/_component-base.twig" %}

{% block container %}
<div class="container">

	<header class="{{ local_namespace }}__header">
		{% include ['partials/heading-array.twig'] ignore missing with { 'headings': headings } %}

		{% if sectionHtml_1 %}
			<div class="{{ local_namespace }}__intro content-flow">{{ sectionHtml_1 }}</div>
		{% endif %}

		{% if categories %}
			<form class="{{ local_namespace }}__filter">
				<label for="brands-listing-category" class="sr-only">{{ CategoryDropdown.label }}</label>
				<select class="form-control" id="brands-listing-category">
					<option value="">{{ CategoryDropdown.placeholder }}</option>
					{% for category in categories %}
						<option value="{{ category.slug }}">{{ category.title }}</option>
					{% endfor %}
				</select>
			</form>
		{% endif %}
	</header>

	{% if brands %}
		<div class="{{ local_namespace }}__grid">
			{% for brand in brands %}
				{% set brand_image = brand.image1 ?: brand.thumbnail.id %}
				<article class="{{ local_namespace }}__card" data-categories="{% for term in brand.terms({query:{taxonomy:'product_line', orderby:'name', order: 'ASC'}}) %}{{ term.slug }}{{ not loop.last ? "," }}{% endfor %}" {{ loop.index > per_page ? "hidden" }}>
					<div class="{{ local_namespace }}__image">
						{% if brand_image %}
							{% include ['partials/image.twig'] ignore missing with { 'id': brand_image, 'alt': brand.title } %}
						{% else %}
							{# Most brands have no photo yet: their name stands in for it. #}
							<span class="{{ local_namespace }}__image-text">{{ brand.title }}</span>
						{% endif %}
					</div>
					<div class="{{ local_namespace }}__body">
						<div class="{{ local_namespace }}__brand">
							{% if brand.logo %}
								<div class="{{ local_namespace }}__logo">
									{% include ['partials/image.twig'] ignore missing with { 'id': brand.logo, 'alt': brand.title } %}
								</div>
							{% elseif brand_image %}
								<div class="{{ local_namespace }}__logo-text">{{ brand.title }}</div>
							{% endif %}
							{% if brand.website %}
								<a href="{{ brand.website }}" target="_blank" title="Visit Website for {{ brand.title }}" class="{{ local_namespace }}__external">
									{% include ['partials/icon.twig'] ignore missing with {'icon': 'link'} %}
									<span class="sr-only">Visit Website for {{ brand.title }} (opens in new window)</span>
								</a>
							{% endif %}
						</div>

						{% if brand.sectionHtml_1 %}
							<p class="{{ local_namespace }}__description">{{ brand.sectionHtml_1|striptags }}</p>
							<a href="{{ brand.link }}" class="{{ local_namespace }}__know-more">
								{{ TableContent.KnowMoreText ?: 'Know More' }}<span class="sr-only"> about {{ brand.title }}</span>
							</a>
						{% endif %}

						<div class="{{ local_namespace }}__actions">
							{% if BrandEcommerceLink_show and brand.shop %}
								<a href="{{ brand.shop }}" target="_blank" title="Shop for {{ brand.title }}" class="{{ local_namespace }}__button">
									<span aria-hidden="true">{{ TableContent.BrandShopLinkText }}</span>
									<span class="sr-only">Shop for {{ brand.title }} (opens in new window)</span>
								</a>
							{% endif %}
							<a href="{{ brand.link }}" class="{{ local_namespace }}__button">
								{{ TableContent.ViewBrandLinkText ?: 'View Brand' }}<span class="sr-only">: {{ brand.title }}</span>
							</a>
						</div>
					</div>
				</article>
			{% endfor %}
		</div>

		<div class="{{ local_namespace }}__more">
			<button type="button" class="{{ local_namespace }}__button {{ local_namespace }}__load-more" data-per-page="{{ per_page }}" {{ brands|length <= per_page ? "hidden" }}>
				{{ TableContent.LoadMoreText ?: 'Load More' }}
			</button>
		</div>
	{% endif %}

	{% if buttonHeading or buttons %}
		<div class="brands--page-content">
			{% include ['partials/heading-array.twig'] ignore missing with { 'headings': buttonHeading } %}

			{% if sectionHtml_2 %}<div class="content-flow">{{ sectionHtml_2 }}</div>{% endif %}

			{% include ['partials/button-array.twig'] ignore missing with { 'buttons': buttons } %}
		</div>
	{% endif %}

</div>
{% endblock %}
