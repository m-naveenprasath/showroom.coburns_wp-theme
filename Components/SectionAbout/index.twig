{# This is a very hacky workaround for sections that require sectionBackground to be used somewhere besides the topmost .section element #}
{% set pseudoBackground = sectionBackground %}
{% set sectionBackground = '' %}
{% extends "partials/_component-base.twig" %}

{% block container %}

	<div class="{{ local_namespace }}--intro {{ pseudoBackground ? "has-pseudo-background has-pseudo-background-" ~ pseudoBackground }} {{ mediaPosition ? "container-image-" ~ mediaPosition }}">

		<div class="container">

			<div class="row align-items-center justify-content-center">

				{% if media.type != 'none' %}

				<div class="container--image container--image-{{ mediaPosition }}">

						{% if media.type == 'image' and media.image %}
							{% include ['partials/image.twig'] ignore missing with { 'image': media.image, 'class': 'shadow' } %}
						{% endif %}

						{% if media.type=='map' and media.map_url %}
							<iframe class="shadow" src="{{media.map_url}}" width="100%" height="450" frameborder="0" border="0" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>
						{% endif %}


					{% if media.type=='video' %}
						{% if media.video_url %}
							<div class="embed-responsive embed-responsive-16by9">
								<iframe src="{{ media.video_url }}" class="embed-responsive-item" frameborder="0"></iframe>
							</div>
						{% endif %}
					{% endif %}

				</div>

				{% endif %}

				<div class="container--text container--text-{{ textPosition }}">
					{% include ['partials/heading-array.twig'] ignore missing with { 'headings': headings } %}

					{% if sectionHtml_1 %}<div class="content-flow">{{sectionHtml_1}}</div>{% endif %}
				</div>

			</div>
		</div>
	</div>

	<div class="{{ local_namespace }}--carousel">

		<div class="container">
			{% include "partials/image-carousel.twig"  %}
		</div>

	</div>

	{% if sectionHtml_2 or buttons %}

	<div class="{{ local_namespace }}--family">

		<div class="container">

			<div class="row justify-content-center">

				<div class="col-12 {{ local_namespace }}--family-logo">
					{% include "patterns/03-elements/13-logos/03-supply-color.twig" %}
				</div>

				<div class="content-flow">
					{{ sectionHtml_2 }}
				</div>

				{% if buttons %}
				<div class="col-12 {{ local_namespace }}--family-buttons">
					{% if buttonHeading %}
						{% include ['partials/heading.twig'] ignore missing with { 'heading': buttonHeading } %}
					{% endif %}

					{% include ['partials/button-array.twig'] ignore missing with { 'button': buttons } %}
				</div>
				{% endif %}

			</div>

		</div>

	</div>

	{% endif %}

{% endblock %}
