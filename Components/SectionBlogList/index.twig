<section class="blog-container {% if sectionTextArea=='Larger Column'%}blog-style-2{% endif %} has-background-{{sectionBackground}}">
	<div class="container">
		<div class="row">
			<div class="blog--text col-md-6 col-lg-4 {% if sectionTextArea=='Larger Column'%} col-xl-4{% else %} col-xl-3{% endif %}">
				{% include ['partials/heading-array.twig'] ignore missing with { 'headings': headings } %}

				{% if sectionHtml_1 %}{{sectionHtml_1}}{% endif %}

				{% include ['partials/button-array.twig'] ignore missing with { 'buttons': buttons } %}

				{% if sectionHtml_2 %}{{sectionHtml_2}}{% endif %}
			</div>

			{% for post in posts %}
				{% if loop.last %}
					<div class="blog--col col-12 col-xl-4">
						<div class="card blog-card">
							{% if post.thumbnail %}<a href="{{ post.link }}" class="card-img-link">{% include ['partials/image.twig'] ignore missing with { 'image': post.thumbnail,'class': 'shadow' } %}</a>{% endif %}
							<div class="card-body">
								<a href="{{ postTypeArchiveLink }}" class="btn btn-link btn-link--previous"><span>{{ labels.morePosts }}</span>{%- include ['partials/icon.twig'] ignore missing with {'icon': 'arrow'} -%}</a>
							</div>
						</div>
					</div>
				{% else %}
					<div class="blog--col col-6 col-md-3 col-lg-4">
						{% include ['partials/blog-card-narrow.twig'] %}
					</div>
				{% endif %}
			{% endfor %}
		</div>
	</div>
</section>
