{% set local_namespace = "locations-why-coburns" %}

<section class="{{ local_namespace }}">
	<div class="container">
		{% if heading %}
			<div class="{{ local_namespace }}__heading text-center">
				{% include ['partials/heading-array.twig'] ignore missing with { 'headings': heading } %}
			</div>
		{% endif %}

		<div class="row justify-content-center text-center {{ local_namespace }}__row">
			{% if features %}
				{% for feature in features %}
					<div class="col-lg-3 col-md-6 d-flex {{ local_namespace }}__col">
						<div class="w-100 {{ local_namespace }}__item">
							{% if feature.icon %}
								<div class="{{ local_namespace }}__icon">
									{%- include ['partials/icon.twig'] ignore missing with {'icon': feature.icon} -%}
								</div>
							{% endif %}

							{% if feature.title %}
								<h3 class="{{ local_namespace }}__title">{{ feature.title }}</h3>
							{% endif %}

							{% if feature.description %}
								<p class="{{ local_namespace }}__description">{{ feature.description }}</p>
							{% endif %}
						</div>
					</div>
				{% endfor %}
			{% endif %}
		</div>
	</div>
</section>
