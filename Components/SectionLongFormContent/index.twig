{% set local_namespace = "section-long-form-content" %}

<section class="{{ local_namespace }}{% if sectionTextAlign == 'left' %} {{ local_namespace }}--left{% endif %}">
	<div class="container">
		{% include ['partials/heading-array.twig'] ignore missing with { 'headings': headings } %}

		{% if sectionHtml_1 %}
			<div class="{{ local_namespace }}__content-wrap" data-longform-toggle-wrap>
				<div class="{{ local_namespace }}__content content-flow" data-longform-content>{{ sectionHtml_1 }}</div>
				<button type="button" class="{{ local_namespace }}__toggle" data-longform-toggle aria-expanded="false" hidden>
					<span data-longform-toggle-text>{{ see_more_label|default('See more') }}</span>
				</button>
			</div>
		{% endif %}
	</div>
</section>
