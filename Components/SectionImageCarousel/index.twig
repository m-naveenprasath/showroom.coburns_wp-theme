{% set local_namespace = "section-image-carousel" %}

<section class="{{ local_namespace }}"{% if backgroundColor %} style="background-color: {{ backgroundColor|e('html_attr') }};"{% endif %}>
	<div class="container">

		{% if headings %}
			<div class="{{ local_namespace }}__heading">
				{% include ['partials/heading-array.twig'] ignore missing with { 'headings': headings } %}
			</div>
		{% endif %}

		{% if carousel %}
			<div class="{{ local_namespace }}__wrap" data-sic-wrap>
				<div class="{{ local_namespace }}__track" data-sic-track>
					{% for item in carousel %}
						{% if item.image %}
							<figure class="{{ local_namespace }}__card" data-sic-card>
								{% include ['partials/image.twig'] ignore missing with { 'image': item.image } %}
							</figure>
						{% endif %}
					{% endfor %}
				</div>

				<div class="{{ local_namespace }}__controls" data-sic-controls>
					<button type="button" class="{{ local_namespace }}__nav {{ local_namespace }}__nav--prev" data-sic-prev aria-label="Previous images">
						<span class="{{ local_namespace }}__nav-icon">
							{%- include ['partials/icon.twig'] ignore missing with {'icon': 'arrow-long'} -%}
						</span>
					</button>
					<div class="{{ local_namespace }}__dots" data-sic-dots></div>
					<button type="button" class="{{ local_namespace }}__nav {{ local_namespace }}__nav--next" data-sic-next aria-label="Next images">
						<span class="{{ local_namespace }}__nav-icon">
							{%- include ['partials/icon.twig'] ignore missing with {'icon': 'arrow-long'} -%}
						</span>
					</button>
				</div>
			</div>
		{% endif %}

	</div>

<script>
(function () {
	document.querySelectorAll('[data-sic-wrap]:not([data-sic-ready])').forEach(function (wrap) {
		wrap.setAttribute('data-sic-ready', '');

		var track    = wrap.querySelector('[data-sic-track]');
		var controls = wrap.querySelector('[data-sic-controls]');
		var dotsWrap = wrap.querySelector('[data-sic-dots]');
		var prevBtn  = wrap.querySelector('[data-sic-prev]');
		var nextBtn  = wrap.querySelector('[data-sic-next]');
		var cards    = track ? track.querySelectorAll('[data-sic-card]') : [];
		if (!cards.length) return;

		var perView = 1;
		var pages   = 1;

		// Left edge of each page, capped at the furthest the track can scroll.
		function pageLeft(page) {
			var maxScroll = track.scrollWidth - track.clientWidth;
			return Math.min(cards[page * perView].offsetLeft, maxScroll);
		}

		function currentPage() {
			if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 4) return pages - 1;

			var closest = 0;
			for (var i = 1; i < pages; i++) {
				if (Math.abs(pageLeft(i) - track.scrollLeft) < Math.abs(pageLeft(closest) - track.scrollLeft)) {
					closest = i;
				}
			}
			return closest;
		}

		function goTo(page) {
			page = Math.max(0, Math.min(pages - 1, page));
			track.scrollTo({ left: pageLeft(page), behavior: 'smooth' });
		}

		function sync() {
			var page = currentPage();
			dotsWrap.querySelectorAll('button').forEach(function (dot, i) {
				dot.classList.toggle('is-active', i === page);
				if (i === page) {
					dot.setAttribute('aria-current', 'true');
				} else {
					dot.removeAttribute('aria-current');
				}
			});
			prevBtn.disabled = page === 0;
			nextBtn.disabled = page === pages - 1;
		}

		function build() {
			var step = cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth;
			var newPerView = Math.max(1, Math.round(track.clientWidth / step));
			var newPages   = Math.ceil(cards.length / newPerView);

			if (newPerView !== perView || newPages !== dotsWrap.children.length) {
				perView = newPerView;
				pages   = newPages;
				dotsWrap.innerHTML = '';
				for (var i = 0; i < pages; i++) {
					var dot = document.createElement('button');
					dot.type = 'button';
					dot.className = 'section-image-carousel__dot';
					dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
					dot.addEventListener('click', goTo.bind(null, i));
					dotsWrap.appendChild(dot);
				}
			}

			controls.hidden = pages < 2;
			sync();
		}

		prevBtn.addEventListener('click', function () { goTo(currentPage() - 1); });
		nextBtn.addEventListener('click', function () { goTo(currentPage() + 1); });
		track.addEventListener('scroll', sync, { passive: true });
		window.addEventListener('resize', build);
		window.addEventListener('load', build);
		build();
	});
})();
</script>
</section>
