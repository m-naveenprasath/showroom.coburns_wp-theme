{% if ankle.SiteAnkle_show %}

{% if ankle.ankle_content %}

{% set ankle_icons = {
	'Style': 'ankle-style',
	'Shop': 'ankle-shop',
	'Location': 'ankle-location',
	'Email': 'ankle-email',
	'Account': 'ankle-account',
	'Wishlist': 'ankle-wishlist'
} %}

<div class="ankle-container">
	<div class="ankle container">
		<div class="row">
			{% for item in ankle.ankle_content %}
				{% set tag = item.ankle_link ? 'a' : 'div' %}
				<div class="col-md-3 ankle-item">
					<{{ tag }} class="ankle-item-inner"{% if item.ankle_link %} href="{{ item.ankle_link.url }}" target="{{ item.ankle_link.target ? item.ankle_link.target : '_self' }}"{% endif %}>
						<span class="ankle-item-icon">
							{% if item.ankle_icon == 'Upload My Own' %}
								{% include ['partials/icon.twig'] ignore missing with {'id': item.ankle_icon_upload.id} %}
							{% elseif ankle_icons[item.ankle_icon] is defined %}
								{% include ['partials/icon.twig'] ignore missing with {'icon': ankle_icons[item.ankle_icon]} %}
							{% endif %}
						</span>
						{% if item.ankle_link.title %}
							<span class="ankle-item-title">{{ item.ankle_link.title }}</span>
						{% endif %}
						{% if item.ankle_text %}<p class="ankle-item-text">{{ item.ankle_text }}</p>{% endif %}
					</{{ tag }}>
				</div>
			{% endfor %}
		</div>
	</div>
</div>

{% endif %}

{% endif %}
