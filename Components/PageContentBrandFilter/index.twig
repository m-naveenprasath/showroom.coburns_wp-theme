{% set local_namespace = "section-brand-filter" %}

{% extends "partials/_component-base.twig" %}

{% block container %}
<div class="container">

	<header class="{{ local_namespace }}__header">
		{% include ['partials/heading-array.twig'] ignore missing with { 'headings': headings ?: [{ 'tag': 'h2', 'text': 'Inspiration by Brands' }] } %}
	</header>

	{% if brands %}
		<div class="{{ local_namespace }}__tabs" role="tablist" aria-label="Brands">
			{% for brand in brands %}
				<button type="button" class="{{ local_namespace }}__tab" role="tab" id="brand-tab-{{ brand.slug }}" aria-controls="brand-{{ brand.slug }}" aria-selected="{{ loop.first ? "true" : "false" }}" {{ not loop.first ? 'tabindex="-1"' }}>
					{% if brand.logo %}
						<span class="{{ local_namespace }}__logo">
							{% include ['partials/image.twig'] ignore missing with { 'id': brand.logo, 'alt': '' } %}
						</span>
					{% endif %}
					<span class="{{ local_namespace }}__name">{{ brand.title }}</span>
				</button>
			{% endfor %}
		</div>

		{% for brand in brands %}
			{% set brand_image = brand.image1 ?: brand.thumbnail.id %}
			<div class="{{ local_namespace }}__panel" role="tabpanel" id="brand-{{ brand.slug }}" aria-labelledby="brand-tab-{{ brand.slug }}" {{ not loop.first ? "hidden" }}>
				<div class="{{ local_namespace }}__gallery">
					<div class="{{ local_namespace }}__image {{ local_namespace }}__image--main">
						{% include ['partials/image.twig'] ignore missing with { 'id': brand_image, 'alt': brand.title } %}

						<div class="{{ local_namespace }}__overlay">
							<div class="{{ local_namespace }}__text">
								<h3 class="{{ local_namespace }}__title">{{ brand.title }}</h3>
								{% if brand.sectionHtml_1 %}
									<p class="{{ local_namespace }}__description">{{ brand.sectionHtml_1|striptags }}</p>
								{% endif %}
							</div>
							<a href="{{ brand.link }}" target="_blank" class="{{ local_namespace }}__button"><span>Explore More</span><span class="sr-only"> {{ brand.title }}</span></a>
						</div>
					</div>

					{% for image in [brand.image2, brand.image3] %}
						{% if image %}
							<div class="{{ local_namespace }}__image">
								{% include ['partials/image.twig'] ignore missing with { 'id': image } %}
							</div>
						{% endif %}
					{% endfor %}
				</div>
			</div>
		{% endfor %}
	{% endif %}

</div>
{% endblock %}
