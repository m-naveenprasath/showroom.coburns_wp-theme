{% extends "partials/section.twig" %}

{% block content %}
<div class="container">
	<div class="justify-content-md-center row">
		<div class="col-md-8 text-center">
			<h1 class="h1 display-1">{{ title }}</h1>
			{{ contentHtml | e('wp_kses_post') }}
			<p>
				<a href="{{ site.url }}" class="btn btn-link btn-link--previous"><span>{{ backLinkLabel | e }}</span></a>
			</p>
		</div>
	</div>
</div>
{% endblock %}
