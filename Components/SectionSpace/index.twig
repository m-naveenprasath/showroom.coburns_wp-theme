{% set local_namespace = "section-space" %}

{# Image 1–3 first, then any additional carousel images #}
{% set slides = [] %}
{% for image in [image_1, image_2, image_3] %}
	{% if image %}{% set slides = slides|merge([image]) %}{% endif %}
{% endfor %}
{% for item in carousel %}
	{% if item.image %}{% set slides = slides|merge([item.image]) %}{% endif %}
{% endfor %}

<section class="{{ local_namespace }} has-background-{{ sectionBackground }}">
	<div class="container">
		<div class="{{ local_namespace }}__inner{% if not slides %} {{ local_namespace }}__inner--text-only{% endif %}">
			<div class="{{ local_namespace }}__card">
				{% include ['partials/heading-array.twig'] ignore missing with { 'headings': headings } %}

				{{sectionHtml_1}}

				{% include ['partials/button-array.twig'] ignore missing with { 'buttons': buttons } %}
			</div>

			{% if slides %}
				<div class="{{ local_namespace }}__wrap" data-ss-wrap>
					<div class="{{ local_namespace }}__track" data-ss-track>
						{% for image in slides %}
							<figure class="{{ local_namespace }}__slide" data-ss-card>
								{% include ['partials/image.twig'] ignore missing with { 'image': image } %}
							</figure>
						{% endfor %}
					</div>

					<div class="{{ local_namespace }}__controls" data-ss-controls>
						<button type="button" class="{{ local_namespace }}__nav {{ local_namespace }}__nav--prev" data-ss-prev aria-label="Previous images">
							<span class="{{ local_namespace }}__nav-icon">
								{%- include ['partials/icon.twig'] ignore missing with {'icon': 'arrow-long'} -%}
							</span>
						</button>
						<div class="{{ local_namespace }}__dots" data-ss-dots></div>
						<button type="button" class="{{ local_namespace }}__nav {{ local_namespace }}__nav--next" data-ss-next aria-label="Next images">
							<span class="{{ local_namespace }}__nav-icon">
								{%- include ['partials/icon.twig'] ignore missing with {'icon': 'arrow-long'} -%}
							</span>
						</button>
					</div>
				</div>
			{% endif %}
		</div>
	</div>

<script>
(function () {
	document.querySelectorAll('[data-ss-wrap]:not([data-ss-ready])').forEach(function (wrap) {
		wrap.setAttribute('data-ss-ready', '');

		var track    = wrap.querySelector('[data-ss-track]');
		var controls = wrap.querySelector('[data-ss-controls]');
		var dotsWrap = wrap.querySelector('[data-ss-dots]');
		var prevBtn  = wrap.querySelector('[data-ss-prev]');
		var nextBtn  = wrap.querySelector('[data-ss-next]');
		var cards    = track ? track.querySelectorAll('[data-ss-card]') : [];
		if (!cards.length) return;

		var perView = 1;
		var pages   = 1;

		// Left edge of each page, capped at the furthest the track can scroll.
		function pageLeft(page) {
			var maxScroll = track.scrollWidth - track.clientWidth;
			return Math.min(cards[page * perView].offsetLeft, maxScroll);
		}

		function currentPage() {
			if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 4) return pages - 1;

			var closest = 0;
			for (var i = 1; i < pages; i++) {
				if (Math.abs(pageLeft(i) - track.scrollLeft) < Math.abs(pageLeft(closest) - track.scrollLeft)) {
					closest = i;
				}
			}
			return closest;
		}

		function goTo(page) {
			page = Math.max(0, Math.min(pages - 1, page));
			track.scrollTo({ left: pageLeft(page), behavior: 'smooth' });
		}

		function sync() {
			var page = currentPage();
			dotsWrap.querySelectorAll('button').forEach(function (dot, i) {
				dot.classList.toggle('is-active', i === page);
				if (i === page) {
					dot.setAttribute('aria-current', 'true');
				} else {
					dot.removeAttribute('aria-current');
				}
			});
			prevBtn.disabled = page === 0;
			nextBtn.disabled = page === pages - 1;
		}

		function build() {
			var step = cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth;
			var newPerView = Math.max(1, Math.round(track.clientWidth / step));
			var newPages   = Math.ceil(cards.length / newPerView);

			if (newPerView !== perView || newPages !== dotsWrap.children.length) {
				perView = newPerView;
				pages   = newPages;
				dotsWrap.innerHTML = '';
				for (var i = 0; i < pages; i++) {
					var dot = document.createElement('button');
					dot.type = 'button';
					dot.className = 'section-space__dot';
					dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
					dot.addEventListener('click', goTo.bind(null, i));
					dotsWrap.appendChild(dot);
				}
			}

			controls.hidden = pages < 2;
			sync();
		}

		prevBtn.addEventListener('click', function () { goTo(currentPage() - 1); });
		nextBtn.addEventListener('click', function () { goTo(currentPage() + 1); });
		track.addEventListener('scroll', sync, { passive: true });
		window.addEventListener('resize', build);
		window.addEventListener('load', build);
		build();
	});
})();
</script>
</section>
