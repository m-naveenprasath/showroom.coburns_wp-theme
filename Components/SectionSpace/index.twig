{% set local_namespace = "space" %}
<section class="{{ local_namespace }}-container has-background-{{ sectionBackground }}">
	<div class="container">
		<div class="row">
			<div class="{{ local_namespace }}--text col-lg-4 col-xl-3">
				{% include ['partials/heading-array.twig'] ignore missing with { 'headings': headings } %}

				{{sectionHtml_1}}

				{% include ['partials/button-array.twig'] ignore missing with { 'buttons': buttons } %}
			</div>
			{% if image_1 %}
			<div class="{{ local_namespace }}--col col-6 col-lg-3 col-lg-4">
				<div class="img-wrap shadow">
					<figure>{% include ['partials/image.twig'] ignore missing with { 'image': image_1 } %}</figure>
				</div>
			</div>
			{% endif %}
			{% if image_2 %}
			<div class="{{ local_namespace }}--col col-6 col-lg-3 col-lg-4">
				<div class="img-wrap shadow">
					<figure>{% include ['partials/image.twig'] ignore missing with { 'image': image_2 } %}</figure>
				</div>
			</div>
			{% endif %}
			{% if image_2 %}
			<div class="{{ local_namespace }}--col col-12 col-xl-4">
				<div class="img-wrap shadow">
					<figure>{% include ['partials/image.twig'] ignore missing with { 'image': image_3 } %}</figure>
				</div>
			</div>
			{% endif %}
		</div>
	</div>
</section>
