<div class="return-top">
    <a class="btn btn-link"><span>Return to Top</span>{%- include ['partials/icon.twig'] ignore missing with {'icon': 'arrow'} -%}</a>
</div>

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">

      {%- set locations_rendered = false -%}
      {%- set locations_column -%}
      {%- if footer_locations.items or footer_locations.view_all.url -%}
      <nav class="site-footer__col site-footer__col--locations" aria-label="{{ footer_locations.title }}">
        <h2 class="site-footer__title">
          <button class="site-footer__toggle" type="button" aria-expanded="false" aria-controls="site-footer-col-locations">
            <span>{{ footer_locations.title }}</span>
            <svg class="site-footer__toggle-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M1 10h18"/><path class="site-footer__toggle-v" d="M10 1v18"/></svg>
          </button>
        </h2>
        <div class="site-footer__panel" id="site-footer-col-locations">
        {%- if footer_locations.items -%}
        <ol class="site-footer__links site-footer__locations">
          {%- for item in footer_locations.items -%}
          <li><a href="{{ item.link }}">{{ item.title }}</a></li>
          {%- endfor -%}
        </ol>
        {%- endif -%}
        {%- if footer_locations.view_all.url -%}
        <a class="site-footer__view-all" href="{{ footer_locations.view_all.url }}" {{ footer_locations.view_all.target == '_blank' ? 'target="_blank" rel="noreferrer noopener"' }}>
          {%- include ['icons/footer-location.svg'] ignore missing -%}
          <span>{{ footer_locations.view_all.title ?: 'View all locations' }}</span>
        </a>
        {%- endif -%}
        </div>
      </nav>
      {%- endif -%}
      {%- endset -%}

      {%- for column in footer_columns -%}
      {%- if column.locations_before -%}{{ locations_column }}{%- set locations_rendered = true -%}{%- endif -%}
      {%- set panel_id = 'site-footer-col-' ~ loop.index -%}
      <nav class="site-footer__col" aria-label="{{ column.title }}">
        <h2 class="site-footer__title">
          <button class="site-footer__toggle" type="button" aria-expanded="false" aria-controls="{{ panel_id }}">
            <span>{{ column.title }}</span>
            <svg class="site-footer__toggle-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M1 10h18"/><path class="site-footer__toggle-v" d="M10 1v18"/></svg>
          </button>
        </h2>
        <ul class="site-footer__links site-footer__panel" id="{{ panel_id }}">
          {%- for item in column.menu.items -%}
          <li>
            <a href="{{ item.link }}" {{ item.target == '_blank' ? 'target="_blank" rel="noreferrer noopener"' }}>{{ item.title }}</a>
          </li>
          {%- endfor -%}
        </ul>
      </nav>
      {%- endfor -%}

      {%- if not locations_rendered -%}{{ locations_column }}{%- endif -%}

      <div class="site-footer__brand">
        <div class="site-footer__logo" aria-label="{{ corporate.name ?: site.name }} Logo">
          {%- include ['patterns/03-elements/13-logos/11-primary-reverse.twig'] ignore missing -%}
        </div>

        {%- if corporate.address -%}
        <address class="site-footer__address">
          <a href="https://www.google.com/maps/search/?api=1&query={{corporate.address.lat}},{{corporate.address.lng}}&query_place_id={{corporate.address.place_id}}" target="_blank" rel="noopener">
            {{ corporate.name ?: site.name }}<br/>
            {{ corporate.address.street_number }} {{ corporate.address.street_name }}{{ corporate.address_suite ? " - " ~ corporate.address_suite }}<br/>
            {{ corporate.address.city }}, {{ corporate.address.state_short ? corporate.address.state_short : corporate.address.state }} {{ corporate.address.post_code }}
          </a>
        </address>
        {%- endif -%}

        {%- if corporate.link.link.url and corporate.link.text -%}
        <a class="site-footer__cta" href="{{ corporate.link.link.url }}" {{ corporate.link.link.target ? 'target="' ~ corporate.link.link.target ~ '" rel="noopener"' }}><span>{{ corporate.link.text }}</span>{%- include ['partials/icon.twig'] ignore missing with {'icon': 'arrow'} -%}</a>
        {%- endif -%}

        {%- if appointment.url -%}
        <a class="btn btn-outline-light site-footer__appointment" href="{{ appointment.url }}">
          {%- include ['icons/mobile-schedule.svg'] ignore missing -%}
          <span>{{ appointment.title }}</span>
        </a>
        {%- endif -%}
      </div>

      <div class="site-footer__bottom">
        {%- if socialCorporate -%}
        <h2 class="site-footer__title">Social Media</h2>
        <ul class="site-footer__social">
          {%- for item in socialCorporate -%}
          <li>
            <a href="{{ item.url }}" target="_blank" rel="noopener">
              {%- include ['icons/footer-' ~ item.service.value ~ '.svg', 'icons/' ~ item.service.value ~ '.svg'] ignore missing -%}
              <span class="sr-only">{{ item.service.label }}{{ item.username ? ': ' ~ item.username }} (opens in new window)</span>
            </a>
          </li>
          {%- endfor -%}
        </ul>
        {%- endif -%}

        {%- if copyright -%}
        <p class="site-footer__copyright">
          {%- apply spaceless -%}
          {{ copyright.label ? copyright.label : '&copy;' }}
          {{ now|date('Y') }},
          {{ copyright.company_name ? copyright.company_name : site.name }}.
          {{ copyright.text ? ' ' ~ copyright.text }}
          {%- endapply -%}
        </p>
        {%- endif -%}
      </div>

    </div>
  </div>
</footer>
