{%- apply spaceless -%}
{%- if button.link and button.text -%}
{%- set class = class ~ " btn" -%}
{%- if button.style == "link" -%}
	{%- set class = class ~ " btn-" ~ button.style ~ " btn-" ~ button.style ~ "-"  ~ button.color -%}
{%- elseif button.style -%}
	{%- set class = class ~ " btn-"  ~ button.style ~ "-" ~ button.color -%}
{%- else -%}
	{%- set class = class ~ " btn-shadow" -%}
	{%- set class = class ~ " btn-"  ~ button.color -%}
{%- endif -%}
{%- if button.iconPosition -%}
	{%- set class = class ~ " btn-icon-" ~ button.iconPosition -%}
{%- endif -%}
<a
	class="{{ class }}"
	href="{{ button.link.url }}"
	{%- if button.link.target -%}target="{{ button.link.target }}"{%- endif -%}
	{%- if button.link.title -%}aria-label="{{ button.link.title }}"{%- endif -%}
	>
	{%- include ['partials/icon.twig'] ignore missing with { 'icon': button.icon } -%}<span>{{ button.text }}</span>
</a>
{%- endif -%}
{%- endapply -%}
