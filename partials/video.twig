{% if video %}
  <div class="embed-responsive embed-responsive-16by9">
    <video src="{{ video }}" autoplay loop muted playsinline></video>
  </div>

	{% elseif YTvideo %}
 <div class="embed-responsive embed-responsive-16by9">
<iframe width="560" height="315" src="https://www.youtube.com/embed/{{ YTvideo }}?autoplay=1&mute=1&controls=0" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
</div>
{% endif %}
