{% if not component_ID %}
	{% set component_ID = local_namespace ~ "-" ~ _key %}
{% endif %}
<div class="container">
	<div class="row align-items-center">
		{% for item in carousel %}
		<div class="col p-3">
			<div class="image">{% include ['partials/image-with-link.twig'] ignore missing with { 'image': item.image ?: item, 'link':item.link?: item } %}</div>
		</div>
		{% endfor %}
	</div>
</div>
