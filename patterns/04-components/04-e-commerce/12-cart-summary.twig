<div class="card cart-summary">
  <article class="card-body">
    <h2>Cart Summary</h2>
    <div class="row">
      <div class="col-6 h5 has-gray-color">Subtotal:</div>
      <div class="col-6 h5 has-gray-color text-right">$1,952.30</div>
    </div>
    <div class="row">
      <div class="col-6 h5 text-muted">Shipping:</div>
      <div class="col-6 h5 text-muted text-right">Estimate Below</div>
    </div>
    <div class="row">
      <div class="col-6 h5 text-muted">Discounts:</div>
      <div class="col-6 h5 text-muted text-right">$0.00</div>
    </div>
    <form>
      <div class="form-group">
        <label for="zip">Enter Zip Code to Estimate Shipping</label>
        <div class="row">
          <div class="col-7 col-sm-8"><input class="form-control" name="zip" type="text"></div>
          <div class="col-5 col-sm-4">
            <a class="btn btn-outline-primary btn-block btn-shadow has-blue-dark-color" href="#">Go</a>
          </div>
        </div>
      </div>
      <div class="form-group">
        <label for="discount">Discount Code</label>
        <div class="row">
          <div class="col-7 col-sm-8"><input class="form-control" name="discount" type="text"></div>
          <div class="col-5 col-sm-4">
            <a class="btn btn-outline-primary btn-block btn-shadow has-blue-dark-color" href="#">Apply</a>
          </div>
        </div>
      </div>
      <hr/>
      <div class="row">
        <div class="col-6 h5 has-black-color">Total:</div>
        <div class="col-6 h5 has-black-color text-right">$1,952.30</div>
      </div>
      <div class="form-group text-center">
        <button type="submit" class="btn btn-beige btn-block btn-lg has-white-color">{% include "@icons/forms/lock.twig" %}<span>Proceed to Checkout</span></button>
      </div>
    </form>
  </article>
</div>
