<tr class="product-cart-item {{class}}">
  <td class="item">
    <div class="product-cart-item__name">
      <figure class="product-cart-item__image img-wrap img-sm">
        <a href="#"><img src="../../../images/sample/thumb-square-yosemite.jpg"></a>
      </figure>
      <h4 class="title">
        <a href="#">Original Version of Some Product Name</a>
      </h4>
    </div>
  </td>
  <td class="h4 product-cart-item__price product-cart-item__initial-cost">$139.48</td>
  <td class="product-cart-item__quantity">
    {% include "@elements/11-forms/_input-quantity.twig" %}
  </td>
  <td class="h4 product-cart-item__price product-cart-item__subtotal">$139.48</td>
  <td class="product-cart-item__trash">
	<input type="submit" value="" class="btn btn-trash">
  </td>
</tr>
