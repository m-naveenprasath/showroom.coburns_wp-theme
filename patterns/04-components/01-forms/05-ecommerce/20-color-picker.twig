<div class="form-group">
	<label for="size">Color</label><br/>
	<div class="custom-control custom-radio custom-control-inline color-picker">
		<input type="radio" class="custom-control-input" id="yellow" name="color" aria-label="Yellow"><label class="custom-control-label has-yellow-color" for="yellow"></label>
	</div>
	<div class="custom-control custom-radio custom-control-inline color-picker">
		<input type="radio" class="custom-control-input" id="cyan" name="color" aria-label="Cyan"><label class="custom-control-label has-cyan-color" for="cyan"></label>
	</div>
	<div class="custom-control custom-radio custom-control-inline color-picker">
		<input type="radio" class="custom-control-input" id="green" name="color" aria-label="Green"><label class="custom-control-label has-green-color" for="green"></label>
	</div>
	<div class="custom-control custom-radio custom-control-inline color-picker">
		<input type="radio" class="custom-control-input" id="indigo" name="color" aria-label="Indigo"><label class="custom-control-label has-indigo-color" for="indigo"></label>
	</div>
</div>
