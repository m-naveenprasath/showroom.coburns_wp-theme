<div class="form--login">
	<div class="form-row">
		<div class="col-4">
			<div class="h2">Sign in</div>
		</div>
		<div class="col-8 text-muted small text-right">
			Don't have an account? <a href="" class="btn btn-outline-primary btn-shadow ml-2">Sign up</a>
		</div>
	</div>
	<div class="form--login-social py-3">
		<a href="#" class="btn btn-block btn-twitter">
			{% include "@icons/twitter.twig" %}
			<span>Login via Twitter</span>
		</a>
		<a href="#" class="btn btn-block btn-facebook">
			{% include "@icons/facebook.twig" %}
			<span>Login via facebook</span>
			</a>
    <form>
      <div class="form-group">
		<label class="sr-only"></label>
        <div class="input-group input-group--minimal">
          <div class="input-group-prepend">
            <span class="input-group-text">
              {% include "@icons/person.twig" %}
            </span>
          </div>

          <input class="form-control" type="text" id="login" placeholder="Login">
        </div>
      </div>
      <div class="form-group">
		<label class="sr-only"></label>
        <div class="input-group input-group--minimal">
          <div class="input-group-prepend">
            <span class="input-group-text">
              {% include "@icons/lock.twig" %}
            </span>
          </div>
          <input class="form-control" type="password" id="pass" placeholder="Password">
        </div>
      </div>
      <div class="form-group">
        <div class="custom-control custom-checkbox float-right">
          <input type="checkbox" class="custom-control-input" id="rememberLogin">
          <label class="custom-control-label" for="rememberLogin">Remember me</label>
        </div>
        <button type="submit" class="btn btn-primary">Login</button>
      </div>
    </form>
</div>
