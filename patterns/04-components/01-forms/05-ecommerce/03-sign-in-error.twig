<div class="form--login">
	<div class="form--login-header">
    <div class="h2">Sign in to Account</div>
    <p class="text-danger">Oh snap! Change a few things up and try submitting again.</p>
    </div>
    <form>
      <div class="form-group">
				<label class="sr-only">Username</label>
				<div class="input-group">
					<div class="input-group-prepend">
						<span class="input-group-text">{% include "@icons/person.twig" %}</span>
					</div>
					<input class="form-control" type="text" id="acctUsername" placeholder="Username">
					</div>
				</div>
      <div class="form-group">
				<label class="sr-only">Password</label>
        <div class="input-group">
        <div class="input-group-prepend">
          <span class="input-group-text">{% include "@icons/lock.twig" %}</span>
        </div>
        <input class="form-control" type="acctPassword" id="acctPassword" placeholder="Password">
        </div>
      </div>
      <div class="form-group">
        <button type="submit" class="btn btn-primary">Login</button>
      </div>
		</form>
		<div class="form--login-footer">
			<a href="#" class="btn btn-link">Forgot password?</a>
		</div>
</div>
