<div class="sg-theme-showroom">
	<div class="single-locations">
		{% include "@sections/01-header/_showroom-header.twig" %}
		<main>
			<section class="hero-container">
				<div class="container">
					<nav class="breadcrumbs"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="#">Breadcrumb A</a></li><li class="breadcrumb-item active" aria-current="page">Breadcrumb B</li></ol></nav>
					<div class="row">
						<div class="hero--image">
							<img height="426" width="711" src="../../../images/locations-1.jpg" alt="">
							<div class="hero--image-row">
								<div class="hero--image-col col-lg-6"><img height="227" width="345" src="../../../images/locations-2.jpg" alt=""></div>
								<div class="hero--image-col col-lg-6"><img height="227" width="345" src="../../../images/locations-3.jpg" alt=""></div>
							</div>
						</div>
						<div class="hero--text">
							<div class="content-flow-headings">
								<h1 class="heading-style-minimal">Coburn’s Showroom</h1>
								<h2 class="h1 display">Baton Rouge – Airline</h2>
							</div>
							<div class="hero--locations">
								<div class="hero--locations-buttons">
									<div class="button-group"><span class="btn-link--previous"></span>
										<div class="button-col"><a class="btn btn-primary btn-shadow" href="#">Get Directions</a></div>
										<div class="button-col"><a class="btn btn-outline-primary btn-shadow" href="#">Schedule an Appointment</a></div>
									</div>
								</div>
								<div class="hero--locations-text row">
									<div class="col-md-6 content-flow">
										<h3>Address</h3>
										<p>11930 Airline Highway<br/>Baton Rouge, LA 70817</p>
										<h3>Phone</h3>
										<p><a class="has-gray-color" href="tel:+12252923700">(225) 292-3700</a></p>
										<h3>Showroom Manager</h3>
										<p>Jason Kolb</p>
										<h3>Find Us On Social</h3>
										<ul class="hero--sharetoolbar list-unstyled">
											<li><a href="#">{% include "@icons/facebook-color.twig" %}</a></li>
											<li><a href="#">{% include "@icons/google-business-color.twig" %}</a></li>
										</ul>
									</div>
									<div class="col-md-6 content-flow">
										<h3>Showroom Hours</h3>
										<p>Monday to Friday<br/>7:00 am to 5:00 pm</p>
										<h3>Product Lines</h3>
										<p>Appliances, Cabinets, HVAC - Heating, Ventilation, and Air Conditioning, Lighting, Plumbing, Pipes, Valves, &amp; Fittings, Kitchen &amp; Bath Showroom, Waterworks</p>
										<h3>Open Since</h3>
										<p>1978</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
			{% include "@sections/07-locations/_02-bios.twig" %}
		</main>
		<div class="ankle-container">{% include "@sections/03-ankle.twig"%}</div>
		{% include "@sections/04-footer/_footer.twig" %}
	</div>
</div>
