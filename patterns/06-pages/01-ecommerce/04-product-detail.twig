<div class="product-single">
	{% include "@sections/01-header/_ecommerce-header.twig" %}
	<main>
		<section class="product-single-container">
			<div class="container">
				<nav class="breadcrumbs"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="#">Breadcrumb A</a></li><li class="breadcrumb-item active" aria-current="page">Breadcrumb B</li></ol></nav>
			</div>
			<div class="container">
				<div class="row">
					<div class="col-12">
						{% include "@components/04-e-commerce/08-product-detail.twig" %}
					</div>
					<div class="col-12">
						{% include "@components/02-collapses/product.twig" %}
					</div>
				</div>
			</div>
		</section>
		<section class="matching-container">
			<div class="container">
				<h5 class="subhead">Matching Products</h5>
				<div class="carousel-row">
					<div id="carouselMatching" class="carousel slide product-carousel" data-ride="carousel">
						<div class="carousel-inner">
							{% include "@components/04-e-commerce/_product-card-carousel.twig" with {"activeClass": "active","badgeStatus":"<div class='promo-badge promo-badge--new'>new</div>","sampleImage":"landscape-16x9-mountains.jpg"} %}
							{% include "@components/04-e-commerce/_product-card-carousel.twig" with {"badgeStatus":"<div class='promo-badge promo-badge--sale'>sale</div>","sampleImage":"tout-3x4-climber.jpg"} %}
							{% include "@components/04-e-commerce/_product-card-carousel.twig" with {"activeWishlist": "active","badgeStatus":"<div class='promo-badge promo-badge--sale'>sale</div>","sampleImage":"thumb-square-yosemite.jpg"} %}
							{% include "@components/04-e-commerce/_product-card-carousel.twig" with {"badgeStatus":"<div class='promo-badge promo-badge--new'>new</div>","sampleImage":"tout-4x3-stream.jpg"} %}
						</div>
						<ol class="carousel-indicators">
							<li data-target="#carouselMatching" data-slide-to="0" class="active"></li>
							<li data-target="#carouselMatching" data-slide-to="1"></li>
							<li data-target="#carouselMatching" data-slide-to="2"></li>
							<li data-target="#carouselMatching" data-slide-to="3"></li>
						</ol>
					</div>
					<a class="carousel-control-prev" data-target="#carouselMatching" role="button" data-slide="prev">
						<span class="carousel-control-prev-icon" aria-hidden="true"></span>
						<span class="sr-only">Previous</span>
					</a>
					<a class="carousel-control-next" data-target="#carouselMatching" role="button" data-slide="next">
						<span class="carousel-control-next-icon" aria-hidden="true"></span>
						<span class="sr-only">Next</span>
					</a>
				</div>
			</div>
		</section>
		<section class="like-container">
			<div class="container">
				<h5 class="subhead">You May Also Like</h5>
				<div class="carousel-row">
					<div id="carouselLike" class="carousel slide product-carousel" data-ride="carousel">
						<div class="carousel-inner">
							{% include "@components/04-e-commerce/_product-card-carousel.twig" with {"activeClass": "active","badgeStatus":"<div class='promo-badge promo-badge--new'>new</div>","sampleImage":"landscape-16x9-mountains.jpg"} %}
							{% include "@components/04-e-commerce/_product-card-carousel.twig" with {"badgeStatus":"<div class='promo-badge promo-badge--sale'>sale</div>","sampleImage":"tout-3x4-climber.jpg"} %}
							{% include "@components/04-e-commerce/_product-card-carousel.twig" with {"activeWishlist": "active","badgeStatus":"<div class='promo-badge promo-badge--sale'>sale</div>","sampleImage":"thumb-square-yosemite.jpg"} %}
							{% include "@components/04-e-commerce/_product-card-carousel.twig" with {"badgeStatus":"<div class='promo-badge promo-badge--new'>new</div>","sampleImage":"tout-4x3-stream.jpg"} %}
						</div>
						<ol class="carousel-indicators">
							<li data-target="#carouselLike" data-slide-to="0" class="active"></li>
							<li data-target="#carouselLike" data-slide-to="1"></li>
							<li data-target="#carouselLike" data-slide-to="2"></li>
							<li data-target="#carouselLike" data-slide-to="3"></li>
						</ol>
					</div>
					<a class="carousel-control-prev" data-target="#carouselLike" role="button" data-slide="prev">
						<span class="carousel-control-prev-icon" aria-hidden="true"></span>
						<span class="sr-only">Previous</span>
					</a>
					<a class="carousel-control-next" data-target="#carouselLike" role="button" data-slide="next">
						<span class="carousel-control-next-icon" aria-hidden="true"></span>
						<span class="sr-only">Next</span>
					</a>
				</div>
			</div>
		</section>
		<section class="related-container">
			<div class="container">
				<h5 class="subhead">Related Products</h5>
				<div class="carousel-row">
					<div id="carouselRelated" class="carousel slide product-carousel" data-ride="carousel">
						<div class="carousel-inner">
							{% include "@components/04-e-commerce/_product-card-carousel.twig" with {"activeClass": "active","badgeStatus":"<div class='promo-badge promo-badge--new'>new</div>","sampleImage":"landscape-16x9-mountains.jpg"} %}
							{% include "@components/04-e-commerce/_product-card-carousel.twig" with {"badgeStatus":"<div class='promo-badge promo-badge--sale'>sale</div>","sampleImage":"tout-3x4-climber.jpg"} %}
							{% include "@components/04-e-commerce/_product-card-carousel.twig" with {"activeWishlist": "active","badgeStatus":"<div class='promo-badge promo-badge--sale'>sale</div>","sampleImage":"thumb-square-yosemite.jpg"} %}
							{% include "@components/04-e-commerce/_product-card-carousel.twig" with {"badgeStatus":"<div class='promo-badge promo-badge--new'>new</div>","sampleImage":"tout-4x3-stream.jpg"} %}
						</div>
						<ol class="carousel-indicators">
							<li data-target="#carouselRelated" data-slide-to="0" class="active"></li>
							<li data-target="#carouselRelated" data-slide-to="1"></li>
							<li data-target="#carouselRelated" data-slide-to="2"></li>
							<li data-target="#carouselRelated" data-slide-to="3"></li>
						</ol>
					</div>
					<a class="carousel-control-prev" data-target="#carouselRelated" role="button" data-slide="prev">
						<span class="carousel-control-prev-icon" aria-hidden="true"></span>
						<span class="sr-only">Previous</span>
					</a>
					<a class="carousel-control-next" data-target="#carouselRelated" role="button" data-slide="next">
						<span class="carousel-control-next-icon" aria-hidden="true"></span>
						<span class="sr-only">Next</span>
					</a>
				</div>
			</div>
		</section>
		{% include "@components/03-cards/_questions-or-comments.twig" %}
		<section class="popular-products-container has-background-texture">
			<div class="container">
				<h5 class="subhead text-center">Recently Viewed</h5>
				<div class="popular-products--row row">
					<div class="col-md-6 col-lg-3">{% include "@components/04-e-commerce/_product-card-small--wishlist.twig" %}</div>
					<div class="col-md-6 col-lg-3">{% include "@components/04-e-commerce/_product-card-small--wishlist.twig" %}</div>
					<div class="col-md-6 col-lg-3">{% include "@components/04-e-commerce/_product-card-small--wishlist.twig" %}</div>
					<div class="col-md-6 col-lg-3">{% include "@components/04-e-commerce/_product-card-small--wishlist.twig" %}</div>
				</div>
			</div>
			<div class="container">
				<h5 class="subhead text-center pt-5">Popular Products</h5>
				<div class="popular-products--row row">
					<div class="col-md-6 col-lg-3">{% include "@components/04-e-commerce/_product-card-small--wishlist.twig" %}</div>
					<div class="col-md-6 col-lg-3">{% include "@components/04-e-commerce/_product-card-small--wishlist.twig" %}</div>
					<div class="col-md-6 col-lg-3">{% include "@components/04-e-commerce/_product-card-small--wishlist.twig" %}</div>
					<div class="col-md-6 col-lg-3">{% include "@components/04-e-commerce/_product-card-small--wishlist.twig" %}</div>
				</div>
			</div>
		</section>			
	</main>
	<div class="ankle-container">{% include "@sections/03-ankle.twig"%}</div>
	{% include "@sections/04-footer/_footer.twig" %}
</div>