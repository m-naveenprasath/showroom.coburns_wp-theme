													<div class="col">
														<div class="product-small__price">$139.48</div>
													</div>
												</div>
											</div>
										</article>
										<article class="product-small">
											<figure class="product-small__image img-wrap">
												<a href="#"><img src="../../../images/sample/thumb-square-yosemite.jpg" alt="placeholder image"></a>
											</figure>
											<div class="product-small__text">
												<h4 class="product-small__title"><a href="#">Original Version of Some Product Name</a></h4>
												<div class="row">
													<div class="col">
														<div class="product-small__price">$139.48</div>
													</div>
												</div>
											</div>
										</article>
										<article class="product-small">
											<figure class="product-small__image img-wrap">
												<a href="#"><img src="../../../images/sample/thumb-square-yosemite.jpg" alt="placeholder image"></a>
											</figure>
											<div class="product-small__text">
												<h4 class="product-small__title"><a href="#">Original Version of Some Product Name</a></h4>
