									<div class="form-group col-sm-4">
										<label for="billing_city">City</label>
										<input class="form-control" type="text" name="billing_city">
									</div>
									<div class="form-group col-sm-4">
										<label for="billing_state">State</label>
										<select class="form-control" id="billing_state">
											<option value="" disabled="" selected="" hidden="">Choose...</option>
											<option>Louisiana</option>
											<option>Rhode Island</option>
										</select>
									</div>
									<div class="form-group col-sm-4">
										<label for="billing_zip">Zip</label>
										<input class="form-control" type="text" name="billing_zip">
									</div>
								</div>
							</div>
							<h2 class="collapsable-headline collapsable-headline-inline" data-toggle="collapse" href="#collapseShippingInfo" role="button" aria-expanded="true" aria-controls="collapseCart">Shipping Info</h2>
