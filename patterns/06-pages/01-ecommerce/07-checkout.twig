<div class="checkout">
	{% include "@sections/01-header/_checkout-header.twig" %}
	<main>
		<section class="ecommerce-container">
			<div class="container">{% include "@components/04-e-commerce/10-loading-bar.twig" %}</div>
			<div class="container">
				<form>
