										<a href="" class="btn-discount" aria-pressed="false" aria-label="Click to enter discount code."><strong>Have a discount code?</strong></a>
										<div class="discount-settings">
											<label for="discount">Discount Code</label>
											<div class="row">
												<div class="col-7 col-sm-8"><input class="form-control" name="discount" type="text"></div>
												<div class="col-5 col-sm-4">
													<a class="btn btn-outline-primary btn-block btn-shadow has-blue-dark-color" href="#">Apply</a>
												</div>
											</div>
										</div>
										<p><hr/></p>
									</div>
									<div class="row m-0">
										<div class="col-7 col-sm-8 h5 has-gray-color">Subtotal:</div>
										<div class="col-5 col-sm-4 h5 has-gray-color text-right">$1,952.30</div>
									</div>
									<div class="row m-0">
										<div class="col-7 col-sm-8 h5">Shipping:</div>
										<div class="col-5 col-sm-4 h5 text-right">$1,952.30</div>
									</div>
									<div class="row m-0">
