							</div>
							<h2 class="collapsable-headline" data-toggle="collapse" href="#collapseBillingInfo" role="button" aria-expanded="true" aria-controls="collapseCart">Billing Info</h2>
							<div class="collapse show" id="collapseBillingInfo">
