						<div class="row justify-content-end">
							<div class="product-sort">
								<select class="form-control">
									<option selected="selected" value="">Sort By...</option>
									<option value="Manufacturer">Brand</option>
									<option value="ItemName">Product Name</option>
									<option value="ItemIDDesc">Newest Products</option>
									<option value="PriceAsc">Priced Low to High</option>
									<option value="PriceDesc">Priced High to Low</option>
									<option value="SalesRank">Best Sellers</option>
